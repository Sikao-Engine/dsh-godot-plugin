{
  "name": "dsh-godot-plugin",
  "version": "0.1.0",
  "private": false,
  "description": "Installable Graphics101 native Vulkan 3D demo for the DSH native viewport preview fork; no Godot runtime.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "native/win32-x64",
    "runtime-manifest.json"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.1-rc.3"
  },
  "packageManager": "pnpm@11.28.5",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../ai/deepseek-harness/vendor/cordis",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "release:stage": "pnpm run graphics101:build && pnpm run build && node scripts/release.mjs",
    "release:pack": "pnpm run release:stage && pnpm pack --out dist/dsh-godot-plugin-0.1.0.tgz",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test tests/*.test.mjs",
    "test:web": "node scripts/smoke-web.mjs",
    "graphics101:build": "node scripts/graphics101.mjs build",
    "graphics101:run": "node scripts/graphics101.mjs run",
    "graphics101:verify": "node scripts/graphics101.mjs verify",
    "graphics101:electron": "node scripts/graphics101.mjs electron",
    "graphics101:electron:smoke": "node scripts/graphics101.mjs electron-smoke",
    "check": "pnpm run typecheck && pnpm run build && pnpm test",
    "dsh:doctor": "node scripts/dsh-dev.mjs doctor",
    "dsh:build": "node scripts/dsh-dev.mjs build",
    "dsh:web": "node scripts/dsh-dev.mjs web",
    "dsh:desktop": "node scripts/dsh-dev.mjs desktop",
    "dsh:install:web": "node scripts/dsh-dev.mjs install-web",
    "dsh:install:desktop": "node scripts/dsh-dev.mjs install-desktop",
    "dsh:dump": "node scripts/dsh-dev.mjs dump"
  }
}
